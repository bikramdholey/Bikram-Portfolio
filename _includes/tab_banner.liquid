{%- comment -%}
  Animated, theme-coloured scenes (drawn by assets/js/tab-banners.js).

  Hero background, placed inside a page's <header class="post-header">:
    {% include tab_banner.liquid %}                 (scene from the page's `banner:`)
    {% include tab_banner.liquid scene="pub-hero" %}
  Grid of research-topic cards (Publications → Specialization):
    {% include tab_banner.liquid grid="specialization" %}
{%- endcomment -%}
{%- if include.grid == "specialization" -%}
  <div class="scene-grid" aria-label="Research specialization">
    {%- assign topics = "elastic-waves|Elastic waves|SH-waves in layered media,vibrations|Vibrations|Modal response of structures,piezoelectric|Piezoelectric materials|Electromechanical coupling,energy-harvesting|Energy harvesting|Vibration to electricity,metamaterials|Metamaterials|Band gaps & wave control,thermoelastic|Thermoelastic media|Heat-coupled waves & damping" | split: "," -%}
    {%- for topic in topics -%}
      {%- assign parts = topic | split: "|" %}
      <figure class="scene-card">
        <canvas data-scene="{{ parts[0] }}" role="img" aria-label="Animation: {{ parts[1] }}"></canvas>
        <figcaption><strong>{{ parts[1] }}</strong><span>{{ parts[2] }}</span></figcaption>
      </figure>
    {%- endfor %}
  </div>
  <script defer src="{{ '/assets/js/tab-banners.js' | relative_url | bust_file_cache }}"></script>
{%- else -%}
  {%- assign scene = include.scene | default: page.banner -%}
  {%- if scene and scene != "" %}
    <canvas class="scene-bg" data-scene="{{ scene }}" data-hero="1" aria-hidden="true"></canvas>
    <div class="scene-veil" aria-hidden="true"></div>
    <script defer src="{{ '/assets/js/tab-banners.js' | relative_url | bust_file_cache }}"></script>
  {%- endif -%}
{%- endif -%}
