<style>
  .memory-manage {
    margin: 0 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--global-theme-color);
    border-radius: 10px;
  }

  .memory-manage[hidden] {
    display: none;
  }

  .memory-manage p {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }

  .memory-manage-btn {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border-radius: 8px;
    background: var(--global-theme-color);
    color: #fff !important;
    font-weight: 600;
    text-decoration: none !important;
  }
</style>

<script>
  // Owner tools stay hidden for visitors: ?manage turns them on (remembered on this
  // device), ?manage=off turns them off again.
  (function () {
    var key = "memoriesManage";
    var param = new URLSearchParams(location.search).get("manage");
    try {
      if (param === "off") localStorage.removeItem(key);
      else if (param !== null) localStorage.setItem(key, "1");
    } catch (e) {}
    var on = param !== null && param !== "off";
    try {
      on = on || localStorage.getItem(key) === "1";
    } catch (e) {}
    if (on) {
      document.querySelectorAll(".memory-manage").forEach(function (el) {
        el.hidden = false;
      });
    }
  })();
</script>
